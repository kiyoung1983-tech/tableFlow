root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,kt,kts,ts,tsx,js,mjs,json,yaml,yml,css,md,properties,sql}]
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.ps1]
indent_size = 4
